<Window x:Class="WindowsPlatform.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsPlatform"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FF43444E" Margin="1,1,1,1">
        <Canvas x:Name="editing_canvas" Margin="0,34,0,350" Height="50" VerticalAlignment="Top">
            <Button x:Name="view_files" Canvas.Left="5" Canvas.Top="5" HorizontalAlignment="Left" FontWeight="Bold" BorderThickness="1,1,1,1" Height="35" VerticalAlignment="Center" FontFamily="Arial" Width="35" BorderBrush="#00707070" Click="OnViewClick">
                <Button.Background>
                    <ImageBrush ImageSource="C:\Users\Ndiph\Documents\Git\WindowsPlatform\Sources\upload.png"/>
                </Button.Background>
                <Label x:Name="txt_view" Content="Projects" Height="7" FontSize="6" Width="34" VerticalContentAlignment="Bottom" FontFamily="Arial Black" Padding="0,0,0,0" HorizontalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" RenderTransformOrigin="0.5,0.5">
                    <Label.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform X="0" Y="20"/>
                        </TransformGroup>
                    </Label.RenderTransform>
                </Label>
            </Button>
            <Button x:Name="view_stage" Canvas.Left="5" Canvas.Top="5" FontWeight="Bold" BorderThickness="1,1,1,1" Height="35" FontFamily="Arial" Width="35" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" BorderBrush="#00707070" Click="OnStageClick">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform X="30"/>
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.Background>
                    <ImageBrush ImageSource="C:\Users\Ndiph\Documents\Git\WindowsPlatform\Sources\file.png"/>
                </Button.Background>
                <Label x:Name="txt_view_Copy" Content="Update" Height="7" FontSize="6" Width="34" VerticalContentAlignment="Bottom" FontFamily="Arial Black" Padding="0,0,0,0" HorizontalContentAlignment="Center" Foreground="White" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Label.Background>
                        <ImageBrush/>
                    </Label.Background>
                    <Label.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform X="0" Y="20"/>
                        </TransformGroup>
                    </Label.RenderTransform>
                </Label>
            </Button>
            <Button x:Name="view_commit" Canvas.Left="5" Canvas.Top="5" FontWeight="Bold" BorderThickness="1,1,1,1" Height="35" FontFamily="Arial" Width="35" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" BorderBrush="#00707070">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform X="60"/>
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.Background>
                    <ImageBrush ImageSource="C:\Users\Ndiph\Documents\Git\WindowsPlatform\Sources\save.png"/>
                </Button.Background>
                <Label x:Name="txt_commit" Content="Save" Height="7" FontSize="6" Width="34" VerticalContentAlignment="Bottom" FontFamily="Arial Black" Padding="0,0,0,0" HorizontalContentAlignment="Center" Foreground="White" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="">
                    <Label.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform X="0" Y="20"/>
                        </TransformGroup>
                    </Label.RenderTransform>
                </Label>
            </Button>
            <Button x:Name="view_push" Canvas.Left="5" Canvas.Top="5" FontWeight="Bold" BorderThickness="1,1,1,1" Height="35" FontFamily="Arial" Width="35" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" BorderBrush="#00707070">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform X="90"/>
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.Background>
                    <ImageBrush ImageSource="C:\Users\Ndiph\Documents\Git\WindowsPlatform\Sources\upload.png"/>
                </Button.Background>
                <Label x:Name="txt_push" Content="Upload" Height="7" FontSize="6" Width="34" VerticalContentAlignment="Bottom" FontFamily="Arial Black" Padding="0,0,0,0" HorizontalContentAlignment="Center" Foreground="White" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Label.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform X="0" Y="20"/>
                        </TransformGroup>
                    </Label.RenderTransform>
                </Label>
            </Button>
        </Canvas>
        <Canvas x:Name="top_navCanvas">
            <Button x:Name="btn_file" Content="File" RenderTransformOrigin="0.5,0.5" FontFamily="Arial Black" Click="OnFileClick" FontSize="10" AutomationProperties.HelpText="Click to view files" Width="33" HorizontalAlignment="Left" Canvas.Left="10" Canvas.Top="10" VerticalAlignment="Top">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform Y="2"/>
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <Button x:Name="btn_view" Content="View" RenderTransformOrigin="0.5,0.5" FontFamily="Arial Black" Click="OnViewClick" FontSize="10" AutomationProperties.HelpText="Click to" Width="33" HorizontalAlignment="Left" Canvas.Left="48" Canvas.Top="10" VerticalAlignment="Top">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform X="1" Y="2"/>
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <Button x:Name="btn_help" Content="Help" RenderTransformOrigin="0.5,0.5" FontFamily="Arial Black" Click="OnHelpClick" FontSize="10" AutomationProperties.HelpText="Click to view files" Width="33" HorizontalAlignment="Left" Canvas.Left="86" Canvas.Top="10" VerticalAlignment="Top">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform Y="2" X="3"/>
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <Button x:Name="btn_tools" Content="Tools" RenderTransformOrigin="0.5,0.5" FontFamily="Arial Black" Click="OnToolsClick" FontSize="10" AutomationProperties.HelpText="Click for options" HorizontalAlignment="Left" Canvas.Left="124" Canvas.Top="10" VerticalAlignment="Top">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform X="4" Y="2"/>
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <Label x:Name="lbl_response" Content="" RenderTransformOrigin="0.684,4.451" Width="300" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Canvas.Left="317" Canvas.Top="384" VerticalAlignment="Top"/>
            <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Canvas.Left="398" Canvas.Top="215" VerticalAlignment="Top"/>
            <Label x:Name="taskRunning_" FontWeight="Bold" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Canvas.Left="392" Canvas.Top="211" VerticalAlignment="Top"/>
            <Button x:Name="btn_Options" Content="Options" RenderTransformOrigin="0.5,0.5" FontFamily="Arial Black" Click="OnOptionsClick" FontSize="10" AutomationProperties.HelpText="Click for options" HorizontalAlignment="Left" Canvas.Left="162" Canvas.Top="10" VerticalAlignment="Top">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform X="4" Y="2"/>
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <Menu x:Name="file_menu" Height="106" Width="147" Canvas.Left="10" Canvas.Top="41" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#FF1F1F1F" Visibility="Hidden">
                <Label x:Name="initialize_new" Content="Initialize new Repo" Height="18" Width="142" Background="#FF1F1F1F" FontSize="9" FontFamily="Arial Black" VerticalContentAlignment="Center"/>
                <Label x:Name="clone" Content="Clone..." Height="18" Width="142" Background="#FF1F1F1F" FontSize="9" FontFamily="Arial Black"/>
                <Label x:Name="Open" Content="Open Repo" Height="18" Width="142" Background="#FF1F1F1F" FontSize="9" FontFamily="Arial Black"/>
                <Label x:Name="Accounts" Content=" Accounts" Height="18" Width="142" Background="#FF1F1F1F" FontSize="9" FontFamily="Arial Black"/>
            </Menu>
            <TabControl x:Name="Repository_Tabs" Height="338" Width="798" HorizontalAlignment="Center" Canvas.Top="94" VerticalAlignment="Top">
                <TabItem x:Name="firstTab" Header="firstTab" Height="22" Margin="-2,-2,-2,0" VerticalAlignment="Top">
                    <Grid Background="#FF050B12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="85*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </TabItem>
                <TabItem x:Name="ScndTab" Header="SecTab" Visibility="Hidden">
                    <Grid Background="#FFE5E5E5"/>
                </TabItem>
            </TabControl>
        </Canvas>



    </Grid>
</Window>
